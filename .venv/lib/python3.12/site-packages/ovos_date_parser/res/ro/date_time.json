{
  "decade_format": {
    "1": {"match": "^\\d$", "format": "{x}"},
    "2": {"match": "^1\\d$", "format": "{xx}"},
    "3": {"match": "^\\d0$", "format": "{x0}"},
    "4": {"match": "^[2-9]\\d$", "format": "{x0} și {x}"},
    "default": "{number}"
  },
  "hundreds_format": {
    "1": {"match": "^1\\d{2}$", "format": "o sută"},
    "2": {"match": "^2\\d{2}$", "format": "două sute"},
    "3": {"match": "^\\d{3}$", "format": "{x_in_x00} sute"},
    "default": "{number}"
  },
  "thousand_format": {
    "1": {"match": "^10\\d\\d$", "format": "o mie"},
    "2": {"match": "^11\\d\\d$", "format": "o mie o sută"},
    "3": {"match": "^12\\d\\d$", "format": "o mie două sute"},
    "4": {"match": "^1[3-9]\\d\\d$", "format": "o mie {x_in_x00} sute"},
    "5": {"match": "^20\\d\\d$", "format": "două mii"},
    "6": {"match": "^21\\d\\d$", "format": "două mii o sută"},
    "7": {"match": "^22\\d\\d$", "format": "două mii două sute"},
    "8": {"match": "^2[3-9]\\d\\d$", "format": "două mii {x_in_x00} sute"},
    "9": {"match": "^[3-9]0\\d{2}$", "format": "{x_in_x000} mii"},
    "10": {"match": "^[3-9]1\\d{2}$", "format": "{x_in_x000} mii o sută"},
    "11": {"match": "^[3-9]2\\d{2}$", "format": "{x_in_x000} mii două sute"},
    "12": {"match": "^[3-9][3-9]\\d{2}$", "format": "{x_in_x000} mii {x_in_x00} sute"},
    "default": "{number}"
  },
  "year_format": {
    "1": {"match": "^\\d\\d?$", "format": "{formatted_decade} {bc}"},
    "2": {"match": "^\\d00$", "format": "{formatted_hundreds} {bc}"},
    "3": {"match": "^\\d{3}$", "format": "{formatted_hundreds} {formatted_decade} {bc}"},
    "4": {"match": "^\\d\\d00$", "format": "{formatted_thousand} {bc}"},
    "5": {"match": "^\\d{4}$", "format": "{formatted_thousand} {formatted_decade} {bc}"},
    "default": "{year} {bc}",
    "bc": "î.Hr."
  },
  "date_format": {
    "date_full": "{weekday}, {day} {month} {formatted_year}",
    "date_full_no_year": "{weekday}, {day} {month}",
    "date_full_no_year_month": "{weekday}, ziua {day}",
    "today": "azi",
    "tomorrow": "mâine",
    "yesterday": "ieri"
  },
  "date_time_format": {
    "date_time": "{formatted_date} la {formatted_time}"
  },
  "weekday": {
    "0": "luni",
    "1": "marți",
    "2": "miercuri",
    "3": "joi",
    "4": "vineri",
    "5": "sâmbătă",
    "6": "duminică"
  },
  "date": {
