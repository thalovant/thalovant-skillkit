{
  "decade_format": {
    "1": {
      "match": "^\\d$",
      "format": "{x}"
    },
    "2": {
      "match": "^1\\d$",
      "format": "{xx}"
    },
    "3": {
      "match": "^\\d0$",
      "format": "{x0}"
    },
    "4": {
      "match": "^[2-9]\\d$",
      "format": "{x} و{x0}"
    },
    "default": "{number}"
  },
  "hundreds_format": {
    "1": {
      "match": "^\\d{3}$",
      "format": "{x00}"
    },
    "default": "{number}"
  },
  "thousand_format": {
    "1": {
      "match": "^\\d0\\d\\d$",
      "format": "{x000}"
    },
    "2": {
      "match": "^\\d{4}$",
      "format": "{x000} و{formatted_hundreds}"
    },
    "default": "{number}"
  },
  "year_format": {
    "1": {
      "match": "^\\d\\d?$",
      "format": "{formatted_decade} {bc}"
    },
    "2": {
      "match": "^\\d00$",
      "format": "{formatted_hundreds} {bc}"
    },
    "3": {
      "match": "^\\d{3}$",
      "format": "{formatted_hundreds} و{formatted_decade} {bc}"
    },
    "4": {
      "match": "^\\d\\d00$",
      "format": "{formatted_thousand} {bc}"
    },
    "5": {
      "match": "^\\d\\d0\\d$",
      "format": "{formatted_thousand} و{formatted_decade} {bc}"
    },
    "6": {
      "match": "^\\d{4}$",
      "format": "{formatted_thousand} و{formatted_decade} {bc}"
    },
    "default": "{year} {bc}",
    "bc": "قبل الميلاد"
  },
  "date_format": {
    "date_full": "{weekday}، {day} من {month} {formatted_year}",
    "date_full_no_year": "{weekday}، {day} من {month}",
    "date_full_no_year_month": "{weekday}، {day}",
    "today": "اليوم",
    "tomorrow": "غداً",
    "yesterday": "أمس"
  },
  "date_time_format": {
    "date_time": "{formatted_date} {formatted_time}"
  },
