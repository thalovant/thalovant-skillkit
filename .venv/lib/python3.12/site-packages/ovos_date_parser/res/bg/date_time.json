{
  "decade_format": {
    "1": {"match": "^\\d$", "format": "{x}"},
    "2": {"match": "^1\\d$", "format": "{xx}"},
    "3": {"match": "^\\d0$", "format": "{x0}"},
    "4": {"match": "^[2-9]\\d$", "format": "{x0} и {x}"},
    "default": "{number}"
  },
  "hundreds_format": {
    "1": {"match": "^\\d{3}$", "format": "{x_in_x00} сто"},
    "default": "{number}"
  },
  "thousand_format": {
    "1": {"match": "^\\d{4}$", "format": "{x_in_x000} хиляди"},
    "default": "{number}"
  },
  "year_format": {
    "default": "{year} {bc}",
    "bc": "пр.н.е."
  },
  "date_format": {
    "date_full": "{weekday}, {day} {month} {formatted_year}",
    "date_full_no_year": "{weekday}, {day} {month}",
    "date_full_no_year_month": "{weekday}, {day}",
    "today": "днес",
    "tomorrow": "утре",
    "yesterday": "вчера"
  },
  "date_time_format": {
    "date_time": "{formatted_date} в {formatted_time}"
  },
